# Copy this file to .env and fill in your relay key:
#
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# .env is read by ccproxy itself (local and docker runs alike) and by
# docker compose for the ${...} values in docker-compose.yml.
# It is git-ignored and kept out of the docker image -- never commit it.

# --- required: the relay's API key -----------------------------------------
UPSTREAM_API_KEY=

# --- optional: uncomment what you need --------------------------------------

# A different relay (default: upstream_base_url from config.json)
#TARGET_URL=https://api.justwoker.icu

# docker compose only: host port to publish the proxy on (default 8181).
# Claude Code then uses ANTHROPIC_BASE_URL=http://127.0.0.1:<port>
#CCPROXY_PORT=8181

# docker compose only: host interface to publish on (default 127.0.0.1).
# Set 0.0.0.0 only on a trusted, firewalled network -- the proxy has no
# authentication of its own.
#CCPROXY_BIND=127.0.0.1
