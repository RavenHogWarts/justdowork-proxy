.venv/
venv/
env/
__pycache__/
*.py[cod]

# runtime output
debug_dump/
*.log
ccproxy_log.txt*

# not needed inside the container (host-side helpers)
.git/
.github/
.gitignore
start.sh
start.bat
run-claude.sh
run-claude.bat
run_tests.sh
run-tests.bat
test_offline.py
agent_proxy.py
names_probe.py
DOCKER.md
DOCKER.zh-CN.md
.dockerignore
Dockerfile
docker-compose.yml
